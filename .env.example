# =============================================================================
# gw-mailbox — environment template.  Copy to .env and edit.
#
#   cp .env.example .env
#   docker compose up -d --build
# =============================================================================

# ---- Host / public URL (REQUIRED for a real deployment) ---------------------
# The public origin of this instance. Used for:
#   * PocketBase appURL  (OAuth2 redirect validation + absolute links)
#   * CSAT survey links emailed to customers
# Must be https:// in production (OAuth2 requires it).
#
# DOMAIN is used by Caddy for automatic HTTPS.
DOMAIN=mailbox.example.com
MAILBOX_PUBLIC_URL=https://mailbox.example.com

# ---- First admin (superuser) — created on first boot if absent --------------
# Gives you Dashboard access (/_/) and the app's Settings screens.
# Change these before the first `docker compose up`; leaving the password blank
# just means no admin is auto-created (use ./pocketbase superuser upsert).
MAILBOX_ADMIN_EMAIL=admin@example.com
MAILBOX_ADMIN_PASSWORD=change-me-please

# ---- Demo data (keep OFF for production) ------------------------------------
# 1 = on a FRESH data dir, seed demo agents (alice@demo.local / bob@demo.local)
#     + demo inboxes and conversations. Never runs if any inbox already exists.
#     MUST be 0 for anything a client will see.
#
# The demo agents' password is taken from MAILBOX_DEMO_PASSWORD. If that is
# unset a random one is generated — set it explicitly if you want to log in as
# the demo users.
MAILBOX_SEED_DEMO=0
MAILBOX_DEMO_PASSWORD=

# ---- PocketBase -------------------------------------------------------------
# Encryption secret for pb_data. Set once, then never change it (changing it
# makes stored encrypted values unreadable). Leave empty to let PB generate one.
PB_ENCRYPTION_KEY=

# ---- Google service account (domain-wide delegation) ------------------------
# Either inline JSON…
# GOOGLE_SA_JSON={"type":"service_account","project_id":"…","private_key_id":"…","private_key":"-----BEGIN PRIVATE KEY-----\n…","client_email":"svc@PROJECT.iam.gserviceaccount.com",…}
# …or a file path:
GOOGLE_SA_FILE=

# Pub/Sub topic Gmail push notifications are delivered to
#   projects/{project}/topics/{topic}
GOOGLE_PUBSUB_TOPIC=

# Optional RS256 signer sidecar (POST {claim, privateKey} -> {signedJwt}).
# PB 0.39 dropped rsaSign, so the service-account JWT is signed by this sidecar
# if reachable, otherwise it falls back to local `openssl` (which the image has).
GOOGLE_SIGNER_URL=http://localhost:9999/sign

# ---- Sync mode --------------------------------------------------------------
# 1 = poll Gmail every minute via cron (no Pub/Sub needed). 0/empty = push.
MAILBOX_POLL_SYNC=1

# ---- SLA policy -------------------------------------------------------------
# Hours added to a new thread's sla_due_at (default 24).
MAILBOX_SLA_HOURS=24

# ---- Alerts -----------------------------------------------------------------
# Optional webhook receiving SLA breach notifications.
MAILBOX_ALERT_WEBHOOK=

# ---- Webhook security -------------------------------------------------------
# If set, Gmail pushes must include  X-Mailbox-Webhook-Token: <this>.
# Leave empty in dev; in production prefer Pub/Sub OIDC tokens.
MAILBOX_WEBHOOK_SECRET=

# ---- Optional overrides -----------------------------------------------------
# CSAT surveys globally on/off (normally configured in Settings; off by default)
# MAILBOX_CSAT_ENABLED=1
# Extra allowed CORS origin for the SPA (same-origin is always allowed)
# MAILBOX_ALLOWED_ORIGIN=
# Calendar/UI timezone
MAILBOX_TIMEZONE=UTC
