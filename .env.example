# =============================================================================
# gw-mailbox — environment template (copy to .env and adjust)
# =============================================================================

# ---- PocketBase ------------------------------------------------
# Encryption secret for pb_data (set once; don't change afterwards).
PB_ENCRYPTION_KEY=

# ---- Google service account (domain-wide delegation) -----------
# Either inline JSON…
# GOOGLE_SA_JSON={"type":"service_account","project_id":"…","private_key_id":"…","private_key":"-----BEGIN PRIVATE KEY-----\n…","client_email":"svc@PROJECT.iam.gserviceaccount.com",…}
# …or a file path:
GOOGLE_SA_FILE=

# Pub/Sub topic the Gmail push notifications are delivered to:
#   projects/{project}/topics/{topic}
GOOGLE_PUBSUB_TOPIC=

# RS256 signer sidecar (see scripts/signer/). PB 0.39 dropped rsaSign, so the
# service-account JWT is signed either by this sidecar or by local `openssl`.
# Default: http://localhost:9999/sign  (POST {claim, privateKey} -> {signedJwt})
GOOGLE_SIGNER_URL=http://localhost:9999/sign

# ---- SLA policy ------------------------------------------------
# Hours added to a new thread's sla_due_at (default 24).
MAILBOX_SLA_HOURS=24

# ---- Alerts ----------------------------------------------------
# Optional webhook receiving SLA breach notifications.
MAILBOX_ALERT_WEBHOOK=

# ---- Sync mode ------------------------------------------------
# 1 = pull new mail every minute via cron (no Pub/Sub needed). 0/empty = push.
MAILBOX_POLL_SYNC=0

# ---- Webhook security ------------------------------------------
# If set, Gmail pushes must include  X-Mailbox-Webhook-Token: <this>.
# Leave empty in dev. For production prefer Pub/Sub OIDC tokens + JWT verify.
MAILBOX_WEBHOOK_SECRET=

# ---- UI --------------------------------------------------------
# Optional CORS origin for the SPA (same-origin is always allowed).
MAILBOX_ALLOWED_ORIGIN=
# Calendar/UI timezone
MAILBOX_TIMEZONE=UTC
